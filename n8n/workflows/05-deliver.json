        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_limit: 20, p_only_test: $('Deliver params').first().json.onlyTest, p_slack: $('Deliver params').first().json.slackReady, p_email: $('Deliver params').first().json.emailOn, p_allowlist: $('Deliver params').first().json.allowlist }) }}",
        "options": {}
      }
    },
    {
      "id": "n080-plan",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        20
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Wybiera trasę dla każdej odebranej wiadomości. Filtrowanie maili po liście dozwolonych adresów robi baza\n// (claim_deliveries), więc tutaj trafiają tylko wiadomości, które wolno wysłać.\nreturn $input.all().map(({ json: m }) => {\n  const route = m.channel === 'slack' ? 'slack:send' : m.channel === 'email' ? 'email:send' : 'skip';\n  return { json: { ...m, route } };\n});\n"
      }
    },
