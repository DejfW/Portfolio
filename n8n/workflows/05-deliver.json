    {
      "id": "n088-failure-reason",
      "name": "Failure reason",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Opis błędu wysyłki do zapisania w kolejce. Adresy URL są wycinane, bo adres webhooka Slacka jest sekretem.\nconst j = $input.first().json;\nconst e = j.error;\nconst raw = e && typeof e === 'object' ? (e.message || e.description || 'unknown')\n  : e || (typeof j.data === 'string' && j.data ? `odpowiedź: ${j.data}` : 'unknown');\nreturn [{ json: { text: String(raw).replace(/https?:\\/\\/\\S+/g, '<url>').slice(0, 200) } }];\n"
      }
    },
