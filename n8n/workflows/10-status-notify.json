            },
            {
              "id": "cfg-statusUrl",
              "name": "statusUrl",
              "value": "={{ $env.STATUS_URL || '' }}",
              "type": "string"
            },
            {
              "id": "cfg-reviewUrl",
              "name": "reviewUrl",
              "value": "={{ $env.GOOGLE_REVIEW_URL || '' }}",
              "type": "string"
            },
            {
