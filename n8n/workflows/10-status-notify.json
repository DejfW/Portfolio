    {
      "id": "n180-config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        100
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "cfg-projectDir",
              "name": "projectDir",
              "value": "={{ $env.PROJECT_DIR }}",
              "type": "string"
            },
            {
              "id": "cfg-allowMock",
              "name": "allowMock",
              "value": "={{ $env.ALLOW_LLM_MOCK || '0' }}",
              "type": "string"
            },
            {
              "id": "cfg-ownerEmail",
              "name": "ownerEmail",
              "value": "={{ $env.OWNER_EMAIL || 'owner@example.com' }}",
