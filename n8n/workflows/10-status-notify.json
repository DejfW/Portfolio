              "name": "emailDelivery",
              "value": "={{ $env.EMAIL_DELIVERY || 'off' }}",
              "type": "string"
            },
            {
              "id": "cfg-emailAllowlist",
              "name": "emailAllowlist",
              "value": "={{ $env.EMAIL_ALLOWLIST || $env.GMAIL_USER || '' }}",
              "type": "string"
            },
            {
              "id": "cfg-tokenSet",
              "name": "tokenSet",
              "value": "={{ !!$env.INTAKE_TOKEN }}",
              "type": "boolean"
            },
            {
              "id": "cfg-authorized",
              "name": "authorized",
              "value": "={{ !$env.INTAKE_TOKEN || ($json.headers && $json.headers['x-intake-token'] === $env.INTAKE_TOKEN) }}",
              "type": "boolean"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "n181-cron-params",
      "name": "Cron params",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Parametry zadań cyklicznych (powiadomienia o statusie, prośby o opinię). Harmonogram działa zawsze; wywołanie przez\n// webhook jest dozwolone tylko w trybie testowym (ALLOW_LLM_MOCK=1) i może wskazać adres opinii (review_url, tylko https).\n// Wartości z konfiguracji (Config): reviewUrl z GOOGLE_REVIEW_URL, statusUrl ze STATUS_URL.\nconst i = $input.first().json;\nconst viaWebhook = i.headers !== undefined;\nconst testMode = i.allowMock === '1';\nconst body = i.body && typeof i.body === 'object' ? i.body : {};\nlet allowed = !viaWebhook || testMode;\nlet reviewUrl = typeof i.reviewUrl === 'string' && i.reviewUrl ? i.reviewUrl : null;\nif (viaWebhook && testMode && body.review_url !== undefined) {\n  if (typeof body.review_url === 'string' && body.review_url.length <= 300) reviewUrl = body.review_url;\n  else allowed = false;\n}\nreturn [{ json: { viaWebhook, allowed, reviewUrl, statusUrl: typeof i.statusUrl === 'string' && i.statusUrl ? i.statusUrl : null } }];\n"
      }
    },
    {
      "id": "n182-allowed-",
      "name": "Allowed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-allowed-",
              "leftValue": "={{ $json.allowed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n183-forbidden",
      "name": "Forbidden",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
