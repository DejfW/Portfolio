# Skopiuj do .env.local (plik jest poza gitem) i uzupełnij. Nie wklejaj tych wartości do czatu ani do repo.
# Wczytuje go scripts/n8n.sh przy starcie n8n.

# --- Supabase w chmurze: projekt "Portfolio" ---
# Dla scripts/deploy-db.sh. Hasło do bazy ustawiasz przy tworzeniu projektu
# (albo resetujesz: Project Settings -> Database -> Reset database password).
SUPABASE_CLOUD_REF=ifbeqnhgoemhfricouii
SUPABASE_DB_PASSWORD=

# --- Gmail: konto projektu dawidmarekportfolio@gmail.com ---
# Wymaga weryfikacji dwuetapowej i hasła aplikacji:
# Konto Google -> Bezpieczeństwo -> Weryfikacja dwuetapowa -> Hasła aplikacji (16 znaków, bez spacji).
GMAIL_USER=dawidmarekportfolio@gmail.com
GMAIL_APP_PASSWORD=

# --- Slack: kanał #zamowienia-demo ---
# api.slack.com/apps -> Create New App -> From scratch -> Incoming Webhooks -> Add New Webhook to Workspace
# -> wybierz #zamowienia-demo -> skopiuj adres https://hooks.slack.com/services/...
SLACK_WEBHOOK_URL=

# --- Opcjonalnie ---
# Adres, na który idą alerty dla właściciela (domyślnie owner@example.com).
OWNER_EMAIL=
# Wspólny sekret dla webhooka /order (nagłówek X-Intake-Token).
INTAKE_TOKEN=
